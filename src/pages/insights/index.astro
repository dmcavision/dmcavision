---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import CTABox from '../../components/CTABox.astro';

const title = 'Insights | DMCA Vision';
const description = 'Knowledge and updates from DMCA Vision covering copyright protection, trademark enforcement, digital evidence, and online infringement.';
const canonical = 'https://dmcavision.com/insights/';
const articles = (await getCollection('insights')).sort((a, b) =>
  Number(b.data.featured) - Number(a.data.featured) || b.data.date.valueOf() - a.data.date.valueOf()
);
const featuredPillarIds = [
  'changing-landscape-online-copyright-abuse',
  'evidence-intelligence-digital-enforcement',
  'ai-powered-brand-monitoring',
  'detection-to-removal-workflow',
  'deepfakes-impersonation-risk'
];
const featuredPillars = featuredPillarIds
  .map((id) => articles.find((article) => article.id === id))
  .filter((article): article is (typeof articles)[number] => Boolean(article));
const remainingArticles = articles.filter((article) => !featuredPillarIds.includes(article.id));
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'DMCA Vision Insights',
    description,
    url: canonical
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: articles.map((article, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: `https://dmcavision.com/insights/${article.id}/`,
      name: article.data.title
    }))
  }
];
---

<Layout {title} {description} {canonical} structuredData={schema}>
  <Header />
  <main id="main-content" class="content-main">
    <section class="content-list-hero">
      <div class="container">
        <span class="section-kicker light-kicker">Knowledge center</span>
        <h1>Insights</h1>
        <p>{description}</p>
      </div>
    </section>
    <section class="content-list-section" aria-labelledby="latest-insights">
      <div class="container">
        <div class="content-section-heading"><span class="section-kicker">Authority library</span><h2 id="latest-insights">Featured pillar articles</h2></div>
        {featuredPillars[0] && <div class="article-grid featured-grid"><ArticleCard article={featuredPillars[0]} featured /></div>}
        <div class="article-grid pillar-grid">{featuredPillars.slice(1).map((article) => <ArticleCard {article} />)}</div>
        <div class="content-section-heading secondary-heading"><span class="section-kicker">Latest thinking</span><h2>More insights</h2></div>
        <div class="article-grid">{remainingArticles.map((article) => <ArticleCard {article} />)}</div>
        <CTABox />
      </div>
    </section>
  </main>
  <Footer />
</Layout>
