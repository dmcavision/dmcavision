---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ArticleHeader from '../../components/ArticleHeader.astro';
import CTABox from '../../components/CTABox.astro';
import RelatedResources from '../../components/RelatedResources.astro';
import RelatedInsights from '../../components/RelatedInsights.astro';
import { calculateReadingTime } from '../../lib/content';
import { getCategoryDefinition } from '../../lib/contentArchitecture';

export async function getStaticPaths() {
  const resources = await getCollection('resources');
  return resources.map((resource) => ({ params: { slug: resource.id }, props: { resource } }));
}

interface Props { resource: CollectionEntry<'resources'>; }
const { resource } = Astro.props;
const { Content } = await render(resource);
const resources = await getCollection('resources');
const insights = await getCollection('insights');
const { title: articleTitle, description, seoTitle, seoDescription, category, author, authorProfile, reviewedBy, date, lastUpdated, image } = resource.data;
const readingTime = calculateReadingTime(resource.body);
const title = seoTitle ?? `${articleTitle} | DMCA Vision`;
const metaDescription = seoDescription ?? description;
const canonical = `https://dmcavision.com/resources/${resource.id}/`;
const categoryDefinition = getCategoryDefinition('resources', category)!;
const categoryUrl = `https://dmcavision.com/resources/category/${categoryDefinition.slug}/`;
const authorUrl = new URL(authorProfile, 'https://dmcavision.com/').href;
const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: articleTitle,
    description: metaDescription,
    datePublished: date.toISOString(),
    dateModified: (lastUpdated ?? date).toISOString(),
    mainEntityOfPage: canonical,
    author: { '@type': 'Organization', name: author, url: authorUrl },
    ...(reviewedBy ? { reviewedBy: { '@type': 'Organization', name: reviewedBy } } : {}),
    publisher: { '@type': 'Organization', name: 'DMCA Vision LLC', logo: { '@type': 'ImageObject', url: 'https://dmcavision.com/logo.svg' } }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://dmcavision.com/' },
      { '@type': 'ListItem', position: 2, name: 'Resources', item: 'https://dmcavision.com/resources/' },
      { '@type': 'ListItem', position: 3, name: category, item: categoryUrl },
      { '@type': 'ListItem', position: 4, name: articleTitle, item: canonical }
    ]
  }
];
---

<Layout {title} description={metaDescription} {canonical} image={image} ogType="article" structuredData={schemas}>
  <Header />
  <main id="main-content" class="content-main article-page" data-analytics-view="resource" data-article-title={articleTitle} data-article-category={category}>
    <section class="article-header-section"><ArticleHeader title={articleTitle} {description} {category} {author} {authorProfile} {reviewedBy} {date} {lastUpdated} {readingTime} {image} collection="Resources" /></section>
    <div class="container article-layout">
      <article class="prose"><Content /></article>
      <CTABox />
      <RelatedInsights {insights} sourceCategory={category} sourceCollection="resources" />
      <RelatedResources {resources} currentId={resource.id} sourceCategory={category} sourceCollection="resources" />
    </div>
  </main>
  <Footer />
</Layout>
