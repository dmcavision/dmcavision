---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ArticleHeader from '../../components/ArticleHeader.astro';
import CTABox from '../../components/CTABox.astro';
import RelatedResources from '../../components/RelatedResources.astro';
import { calculateReadingTime } from '../../lib/content';

export async function getStaticPaths() {
  const resources = await getCollection('resources');
  return resources.map((resource) => ({ params: { slug: resource.id }, props: { resource } }));
}

interface Props { resource: CollectionEntry<'resources'>; }
const { resource } = Astro.props;
const { Content } = await render(resource);
const resources = await getCollection('resources');
const { title: articleTitle, description, category, author, date, image } = resource.data;
const readingTime = calculateReadingTime(resource.body);
const title = `${articleTitle} | DMCA Vision`;
const canonical = `https://dmcavision.com/resources/${resource.id}/`;
const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: articleTitle,
    description,
    datePublished: date.toISOString(),
    dateModified: date.toISOString(),
    mainEntityOfPage: canonical,
    author: { '@type': 'Organization', name: author },
    publisher: { '@type': 'Organization', name: 'DMCA Vision LLC', logo: { '@type': 'ImageObject', url: 'https://dmcavision.com/logo.svg' } }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://dmcavision.com/' },
      { '@type': 'ListItem', position: 2, name: 'Resources', item: 'https://dmcavision.com/resources/' },
      { '@type': 'ListItem', position: 3, name: articleTitle, item: canonical }
    ]
  }
];
---

<Layout {title} {description} {canonical} image={image} ogType="article" structuredData={schemas}>
  <Header />
  <main id="main-content" class="content-main article-page">
    <section class="article-header-section"><ArticleHeader title={articleTitle} {description} {category} {author} {date} {readingTime} {image} collection="Resources" /></section>
    <div class="container article-layout">
      <article class="prose"><Content /></article>
      <CTABox />
      <RelatedResources {resources} currentId={resource.id} {category} />
    </div>
  </main>
  <Footer />
</Layout>
