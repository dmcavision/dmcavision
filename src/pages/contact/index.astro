---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const title = 'Contact DMCA Vision | Company Information';
const description = 'Contact DMCA Vision LLC for digital copyright, brand protection, evidence, and online enforcement review requests.';
const canonical = 'https://dmcavision.com/contact/';
const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: title,
    description,
    url: canonical,
    mainEntity: { '@type': 'Organization', name: 'DMCA Vision LLC', url: 'https://dmcavision.com/' }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://dmcavision.com/' },
      { '@type': 'ListItem', position: 2, name: 'Contact', item: canonical }
    ]
  }
];
---

<Layout {title} {description} {canonical} structuredData={schemas}>
  <Header />
  <main id="main-content" class="content-main contact-page">
    <section class="content-list-hero">
      <div class="container">
        <nav class="breadcrumbs hub-breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>Contact</span></nav>
        <span class="section-kicker light-kicker">Company contact</span>
        <h1>Contact DMCA Vision</h1>
        <p>Connect with our team about digital copyright protection, brand risk, evidence workflows, and online enforcement review.</p>
      </div>
    </section>

    <section class="contact-information" aria-labelledby="company-information-title">
      <div class="container contact-information-grid">
        <div class="company-summary">
          <span class="section-kicker">Official company information</span>
          <h2 id="company-information-title">DMCA Vision LLC</h2>
          <p>For general company inquiries, use the contact details below. To submit a matter for review, continue to the existing review request form on the DMCA Vision homepage.</p>
          <a class="button" href="/#contact" data-request-review data-analytics-label="Request Review">Request Review</a>
        </div>

        <div class="contact-details" aria-label="DMCA Vision contact details">
          <article>
            <span>Company address</span>
            <address>
              1500 N Grant St<br />
              Ste N<br />
              Denver, Colorado 80203<br />
              United States of America
            </address>
          </article>
          <article>
            <span>Phone</span>
            <h3><a href="tel:+18283412352">+1 828 341 2352</a></h3>
            <p>Company and service inquiries</p>
          </article>
          <article>
            <span>Email</span>
            <h3><a href="mailto:info@dmcavision.com">info@dmcavision.com</a></h3>
            <p>General correspondence</p>
          </article>
          <article class="review-card">
            <span>Review requests</span>
            <h3>Submit case information for review</h3>
            <p>The existing review form connects directly to DMCA Vision's review workflow and contact API.</p>
            <a class="content-action" href="/#contact">Open review request form <span aria-hidden="true">&rarr;</span></a>
          </article>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .contact-information{padding:100px 0 115px;background:linear-gradient(180deg,#f4f8f7,#fff 420px)}
  .contact-information-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:85px;align-items:start}
  .company-summary{position:sticky;top:120px}
  .company-summary h2{margin:12px 0 18px;font-size:clamp(2.25rem,4vw,3.7rem)}
  .company-summary p{max-width:520px;margin-bottom:30px;color:#667085;font-size:.94rem;line-height:1.8}
  .contact-details{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
  .contact-details article{min-height:210px;padding:31px;border:1px solid #dbe5e2;border-radius:15px;background:#fff;box-shadow:0 18px 45px rgba(7,17,31,.06)}
  .contact-details article>span{display:block;margin-bottom:18px;color:#087d54;font-size:.61rem;font-weight:800;letter-spacing:.11em;text-transform:uppercase}
  .contact-details address{color:#263746;font-size:.91rem;font-style:normal;font-weight:650;line-height:1.8}
  .contact-details h3{margin:0 0 10px;font-size:1.15rem;overflow-wrap:anywhere}
  .contact-details h3 a:hover,.contact-details h3 a:focus-visible{color:#087d54}
  .contact-details p{margin:0;color:#7a8995;font-size:.75rem;line-height:1.65}
  .contact-details .review-card{grid-column:1/-1;min-height:0;color:#fff;border-color:#203244;background:#07111f;box-shadow:0 22px 55px rgba(7,17,31,.14)}
  .review-card h3{font-size:1.45rem}.review-card p{max-width:600px;margin-bottom:20px;color:#a8b7c3}.review-card .content-action{color:#72deb8}
  @media(max-width:900px){.contact-information-grid{grid-template-columns:1fr;gap:48px}.company-summary{position:static}.company-summary p{max-width:700px}}
  @media(max-width:560px){.contact-information{padding:68px 0 80px}.contact-details{grid-template-columns:1fr}.contact-details .review-card{grid-column:auto}.contact-details article{min-height:0;padding:25px}.company-summary .button{width:100%}}
</style>
