---
import type { CollectionEntry } from 'astro:content';
import ResourceCard from './ResourceCard.astro';
import { insightToResourceRelations, resourceCategoryRelations, rankByCategory } from '../lib/contentArchitecture';

interface Props {
  resources: CollectionEntry<'resources'>[];
  currentId?: string;
  excludeCategory?: string;
  sourceCategory: string;
  sourceCollection: 'insights' | 'resources';
}

const { resources, currentId, excludeCategory, sourceCategory, sourceCollection } = Astro.props;
const categoryOrder = sourceCollection === 'insights'
  ? insightToResourceRelations[sourceCategory] ?? []
  : resourceCategoryRelations[sourceCategory] ?? [sourceCategory];
const related = rankByCategory(
  resources.filter((resource) => resource.id !== currentId && resource.data.category !== excludeCategory && categoryOrder.includes(resource.data.category)),
  categoryOrder
).slice(0, 2);
---

{related.length > 0 && (
  <section class="related-articles" aria-labelledby="related-resources-title">
    <div class="content-section-heading"><span class="section-kicker">Continue learning</span><h2 id="related-resources-title">Related resources</h2></div>
    <div class="resource-grid related-resource-grid">{related.map((resource) => <ResourceCard {resource} />)}</div>
  </section>
)}
