---
import ArticleMeta from './ArticleMeta.astro';
import ContentImage from './ContentImage.astro';

interface Props {
  title: string;
  description: string;
  category: string;
  author: string;
  date: Date;
  readingTime: string;
  image?: string;
  collection: 'Insights' | 'Resources';
}

const { title, description, category, author, date, readingTime, image, collection } = Astro.props;
const collectionHref = collection === 'Insights' ? '/insights/' : '/resources/';
---

<header class="article-header container">
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href={collectionHref}>{collection}</a></nav>
  <span class="content-label">{category}</span>
  <h1>{title}</h1>
  <p>{description}</p>
  <ArticleMeta {author} {date} {readingTime} />
  <ContentImage {image} alt={title} class="article-hero-media" eager />
</header>
