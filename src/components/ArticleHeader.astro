---
import ArticleMeta from './ArticleMeta.astro';
import ContentImage from './ContentImage.astro';
import { getCategoryDefinition } from '../lib/contentArchitecture';

interface Props {
  title: string;
  description: string;
  category: string;
  author: string;
  authorProfile?: string;
  reviewedBy?: string;
  date: Date;
  lastUpdated?: Date;
  readingTime: string;
  image?: string;
  collection: 'Insights' | 'Resources';
}

const { title, description, category, author, authorProfile, reviewedBy, date, lastUpdated, readingTime, image, collection } = Astro.props;
const collectionHref = collection === 'Insights' ? '/insights/' : '/resources/';
const collectionKey = collection === 'Insights' ? 'insights' : 'resources';
const categoryDefinition = getCategoryDefinition(collectionKey, category);
const categoryHref = `/${collectionKey}/category/${categoryDefinition?.slug}/`;
---

<header class="article-header container">
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href={collectionHref}>{collection}</a><span aria-hidden="true">/</span><a href={categoryHref}>{category}</a></nav>
  <a class="content-label" href={categoryHref}>{category}</a>
  <h1>{title}</h1>
  <p>{description}</p>
  <ArticleMeta {author} {authorProfile} {reviewedBy} {date} {lastUpdated} {readingTime} />
  <ContentImage {image} alt={title} class="article-hero-media" eager />
</header>
