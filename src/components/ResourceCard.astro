---
import type { CollectionEntry } from 'astro:content';
import ContentImage from './ContentImage.astro';
import { calculateReadingTime, formatArticleDate } from '../lib/content';

interface Props { resource: CollectionEntry<'resources'>; }
const { resource } = Astro.props;
const { title, description, category, date, image } = resource.data;
const readingTime = calculateReadingTime(resource.body);
const href = `/resources/${resource.id}/`;
---

<article class="resource-card">
  <ContentImage {image} alt={title} class="resource-card-media" />
  <div class="resource-card-body">
    <div class="resource-taxonomy"><span>Resource</span><span>{category}</span></div>
    <h2><a href={href}>{title}</a></h2>
    <p>{description}</p>
    <div class="card-meta"><time datetime={date.toISOString()}>{formatArticleDate(date, true)}</time><span>{readingTime}</span></div>
    <a class="content-action" href={href} aria-label={`Read ${title}`}>Read article <span aria-hidden="true">→</span></a>
  </div>
</article>
