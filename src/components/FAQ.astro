---
const faqs = [
  ['What is a DMCA takedown?','A DMCA takedown is a process under US copyright law through which a rights holder or authorized representative may notify an online service provider of allegedly infringing material and request its removal or restricted access.'],
  ['What types of content can DMCA Vision help protect?','DMCA Vision can support workflows involving images, video, written works, creative assets, software, digital products and protected brand content.'],
  ['Does every copyright complaint result in removal?','No. Outcomes depend on the facts, platform policies, applicable law and the response of the relevant service provider. No removal outcome can be guaranteed.'],
  ['What information is needed to review an infringement?','Helpful information includes identification of the protected work, the original or authorized source, the infringing URL, ownership details and any relevant context.'],
  ['Can DMCA Vision monitor multiple URLs?','Yes. Monitoring and case workflows can be structured around multiple URLs and online channels, depending on the scope of the engagement.'],
  ['Do you work with businesses and individual creators?','Yes. DMCA Vision supports rights holders ranging from individual creators and photographers to publishers, agencies and businesses.'],
  ['Is DMCA Vision a law firm?','DMCA Vision LLC is not presented as a law firm on this website. Services described here focus on copyright monitoring, evidence workflows and online enforcement support. Where legal advice is required, clients should consult qualified legal counsel.']
];
const schema = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
---
<section class="section faq" id="faq" aria-labelledby="faq-title">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <div class="container faq-layout">
    <div class="faq-intro" data-reveal><span class="section-kicker">Common questions</span><h2 id="faq-title">What Rights Holders<br/>Often Ask</h2><p>Clear answers about copyright monitoring, evidence and online enforcement support.</p><a class="text-link" href="#contact">Ask a different question <span>→</span></a></div>
    <div class="accordion" data-reveal>
      {faqs.map(([question,answer], i) => <details open={i===0}><summary><span>{question}</span><i aria-hidden="true"></i></summary><div class="answer"><p>{answer}</p></div></details>)}
    </div>
  </div>
</section>
