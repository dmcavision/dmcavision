---
import Logo from './Logo.astro';
const nav=[['Solutions','solutions'],['Technology','technology'],['Process','process'],['About','about'],['FAQ','faq'],['Contact','contact']];
---
<footer class="footer">
  <div class="container footer-grid"><div class="footer-brand"><Logo light/><p>Digital copyright monitoring, evidence and online enforcement.</p><span class="identity-line">DMCA Vision LLC <i></i> United States</span></div><div><h3>Navigate</h3>{nav.map(([label,id])=><a href={`/#${id}`}>{label}</a>)}</div><div><h3>Legal</h3><a href="/privacy/">Privacy Policy</a><a href="/terms/">Terms of Service</a><a href="/copyright-policy/">Copyright Policy</a></div><div class="footer-cta"><h3>Protect what you create.</h3><a class="button button-sm" href="/#contact">Submit an Infringement</a><a class="footer-email" href="mailto:contact@dmcavision.com">contact@dmcavision.com</a></div></div>
  <div class="container footer-bottom"><span>© 2026 DMCA Vision LLC. All rights reserved.</span><span>Digital protection, built with clarity.</span></div>
</footer>
