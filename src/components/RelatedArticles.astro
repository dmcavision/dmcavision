---
import type { CollectionEntry } from 'astro:content';
import ArticleCard from './ArticleCard.astro';

interface Props {
  articles: CollectionEntry<'insights'>[];
  currentId: string;
  category: string;
}

const { articles, currentId, category } = Astro.props;
const related = articles
  .filter((article) => article.id !== currentId)
  .sort((a, b) => Number(b.data.category === category) - Number(a.data.category === category))
  .slice(0, 2);
---

{related.length > 0 && (
  <section class="related-articles" aria-labelledby="related-title">
    <div class="content-section-heading"><span class="section-kicker">Continue reading</span><h2 id="related-title">Related insights</h2></div>
    <div class="related-grid">{related.map((article) => <ArticleCard {article} />)}</div>
  </section>
)}
